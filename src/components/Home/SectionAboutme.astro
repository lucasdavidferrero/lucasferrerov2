<section class="py-20 container mx-auto px-4 text-center relative">
    <!-- Section title with accent -->
    <div class="relative inline-block mb-12">
        <h2 class="text-3xl md:text-4xl font-newsreader italic text-white relative z-10">
            Let's briefly talk about me
        </h2>
        <!-- Accent line -->
        <div class="absolute -bottom-2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gold/40 to-transparent"></div>
        <!-- Glow effect -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-burnt-orange/5 blur-2xl -z-10"></div>
    </div>

    <!-- Content with glass morphism card -->
    <div class="max-w-3xl mx-auto">
        <!-- Glass card effect -->
        <div class="relative group">
            <!-- Background blur layer -->
            <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-white/[0.01] backdrop-blur-sm rounded-2xl border border-white/10 group-hover:border-burnt-orange/30 transition-colors duration-500"></div>
            
            <!-- Content -->
            <div class="relative p-8 md:p-12">
                <p class="text-lg md:text-xl text-warm-gray leading-relaxed">
                    I'm a software developer with <span class="text-gold font-medium">4+ years of experience</span> specializing in the web development ecosystem.
                </p>
                
                <div class="my-6 w-24 h-px bg-gradient-to-r from-transparent via-burnt-orange/50 to-transparent mx-auto"></div>
                
                <p class="text-base md:text-lg text-gray-400 leading-relaxed">
                    With years of experience and expertise in the latest technologies and cloud services, I deliver custom solutions that meet clients' unique needs.
                </p>
            </div>

            <!-- Hover glow effect -->
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none">
                <div class="absolute inset-0 bg-gradient-to-br from-burnt-orange/5 to-gold/5 rounded-2xl blur-xl"></div>
            </div>
        </div>

        <!-- Action buttons with modern styling -->
        <div class="mt-12 flex flex-wrap justify-center items-center gap-4">
            <!-- Primary CTA -->
            <a class="relative group inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-burnt-orange/10 to-gold/10 hover:from-burnt-orange/20 hover:to-gold/20 border border-burnt-orange/30 hover:border-gold/50 rounded-lg text-white font-medium transition-all duration-300 overflow-hidden" 
               href="/about">
                <span class="relative z-10">Know more</span>
                <svg class="w-4 h-4 relative z-10 group-hover:translate-x-1 transition-transform duration-300" 
                     xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/>
                </svg>
                <!-- Shine effect -->
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/10 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-700"></div>
            </a>

            <!-- Social links with icon-only design -->
            <div class="flex gap-3">
                <!-- GitHub -->
                <a class="group relative inline-flex items-center justify-center w-12 h-12 border border-gray-800 hover:border-burnt-orange/50 rounded-lg bg-gray-900/50 hover:bg-gray-900 transition-all duration-300" 
                   href="https://github.com/lucasdavidferrero" 
                   target="_blank"
                   aria-label="GitHub profile">
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-burnt-orange transition-colors duration-300" 
                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M12.006 2a9.847 9.847 0 0 0-6.484 2.44 10.32 10.32 0 0 0-3.393 6.17 10.48 10.48 0 0 0 1.317 6.955 10.045 10.045 0 0 0 5.4 4.418c.504.095.683-.223.683-.494 0-.245-.01-1.052-.014-1.908-2.78.62-3.366-1.21-3.366-1.21a2.711 2.711 0 0 0-1.11-1.5c-.907-.637.07-.621.07-.621.317.044.62.163.885.346.266.183.487.426.647.71.135.253.318.476.538.655a2.079 2.079 0 0 0 2.37.196c.045-.52.27-1.006.635-1.37-2.219-.259-4.554-1.138-4.554-5.07a4.022 4.022 0 0 1 1.031-2.75 3.77 3.77 0 0 1 .096-2.713s.839-.275 2.749 1.05a9.26 9.26 0 0 1 5.004 0c1.906-1.325 2.74-1.05 2.74-1.05.37.858.406 1.828.101 2.713a4.017 4.017 0 0 1 1.029 2.75c0 3.939-2.339 4.805-4.564 5.058a2.471 2.471 0 0 1 .679 1.897c0 1.372-.012 2.477-.012 2.814 0 .272.18.592.687.492a10.05 10.05 0 0 0 5.388-4.421 10.473 10.473 0 0 0 1.313-6.948 10.32 10.32 0 0 0-3.39-6.165A9.847 9.847 0 0 0 12.007 2Z" clip-rule="evenodd"/>
                    </svg>
                    <!-- Tooltip -->
                    <span class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none">
                        GitHub
                    </span>
                </a>

                <!-- LinkedIn -->
                <a class="group relative inline-flex items-center justify-center w-12 h-12 border border-gray-800 hover:border-gold/50 rounded-lg bg-gray-900/50 hover:bg-gray-900 transition-all duration-300" 
                   href="https://www.linkedin.com/in/lucas-david-ferrero/" 
                   target="_blank"
                   aria-label="LinkedIn profile">
                    <svg class="w-5 h-5 text-gray-400 group-hover:text-gold transition-colors duration-300" 
                         xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
                        <path fill-rule="evenodd" d="M12.51 8.796v1.697a3.738 3.738 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-.988 1.483 1.595 1.595 0 0 1-1.743-.348A1.607 1.607 0 0 1 5.6 4.5a1.601 1.601 0 0 1 1.6 1.606Z" clip-rule="evenodd"/>
                        <path d="M7.2 8.809H4V19.5h3.2V8.809Z"/>
                    </svg>
                    <!-- Tooltip -->
                    <span class="absolute -top-10 left-1/2 -translate-x-1/2 px-2 py-1 bg-gray-800 text-white text-xs rounded opacity-0 group-hover:opacity-100 transition-opacity duration-300 whitespace-nowrap pointer-events-none">
                        LinkedIn
                    </span>
                </a>
            </div>
        </div>
    </div>

    <!-- Decorative elements -->
    <div class="absolute top-10 left-10 w-24 h-24 border border-burnt-orange/10 rounded-full blur-sm pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-32 h-32 border border-gold/10 rounded-full blur-sm pointer-events-none"></div>
</section>