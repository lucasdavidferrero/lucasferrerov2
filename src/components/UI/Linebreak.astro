---
interface Props {
    hasMargin: boolean;
}

const { hasMargin= true  } = Astro.props;
---

<div class:list={['linebreak', { 'my-8': hasMargin }]} ></div>

<style>
    .linebreak {
        background-image: linear-gradient(96.18deg, rgba(215, 196, 255, 0) 10%, hsla(0, 0%, 78%, .24) 50%, rgba(215, 196, 255, 0) 90%);
        bottom: auto;
        height: 1px;
        left: 0;
        margin-left: auto;
        margin-right: auto;
        position: relative;
        right: 0;
        top: 0;
        width: 100%;
    }
</style>
