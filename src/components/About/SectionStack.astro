---
import TitleSubtitle from "../UI/TitleSubtitle.astro";
---
<section class="py-14 container mx-auto text-center lg:text-left lg:w-1/2 px-4">
    <TitleSubtitle title="Stack" subtitle="Some of the tools and technologies I use on a daily basis" />
    <div class="mt-4">
        <ul class="flex">
           <li>
               <div class="cursor-pointer block bg-gray-900 hover:bg-gray-800 rounded-lg p-2" data-tooltip-target="tooltip-animation" data-tech-name="VueJS">
                   <svg width="50" height="50" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                       <path d="M80 7.00049H100L50 93.2505L0 7.00049H38.25L50 27.0005L61.5 7.00049H80Z" fill="#41B883"/>
                       <path d="M0 7.00049L50 93.2505L100 7.00049H80L50 58.7505L19.75 7.00049H0Z" fill="#41B883"/>
                       <path d="M19.75 7.00049L50 59.0005L80 7.00049H61.5L50 27.0005L38.25 7.00049H19.75Z" fill="#35495E"/>
                   </svg>
               </div>
           </li>
        </ul>

        <div id="tooltip-container">
        </div>
    </div>
</section>

<script>
const tooltipDivContainer: HTMLElement = document.getElementById('tooltip-container')
const techElements: NodeListOf<HTMLDivElement> = document.querySelectorAll('[data-tech-name]')

let toolTips = ''
techElements.forEach((item) => {
    const techName = item.dataset.techName
    const tooltipTargetText = `tooltip-animation-${techName.split(' ').join('-').toLowerCase()}`
    item.dataset.tooltipTarget = tooltipTargetText
    const tooltipElement = `
        <div id="${tooltipTargetText}" role="tooltip" class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-800 rounded-lg shadow-sm opacity-0 tooltip">
                ${techName}
                <div class="tooltip-arrow" data-popper-arrow></div>
        </div>
    `;
    toolTips += tooltipElement
})
tooltipDivContainer.innerHTML = toolTips
</script>
