---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SectionAboutme from '../components/Home/SectionAboutme.astro';
import SectionExperience from '../components/Home/SectionExperience.astro'
import SectionLatestWorks from '../components/Home/SectionLatestWorks.astro'
import SectionTestimonials from '../components/Home/SectionTestimonials.astro'
---

<Layout title="Lucas Ferrero | Fullstack Developer">
	<main>
		<Hero />
		<div>
			<SectionAboutme />
		</div>
		<div>
			<SectionExperience />
		</div>
		<div class="bg-hero-lastestworks w-full bg-[url('/hero-bg-alternative-sm.jpg')] lg:bg-[url('/hero-bg-alternative.jpg')]">
			<div>
				<SectionLatestWorks />
			</div>
		</div>
		<div class="bg-hero-testimonials" style="background-image: url('/fire-flakes-overlay-freeject-2.jpg');">
			<SectionTestimonials />
		</div>
	</main>
</Layout>

<style>
	.bg-hero-lastestworks {
		background-size: cover;
		background-position: center top -20px;
		background-repeat: no-repeat;
	}
	.bg-hero-testimonials {
		background-position: center;
		background-size: auto 100%;
		background-repeat: repeat-x;
		background-origin: content-box;
	}
</style>
