---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionIntro from '../components/About/SectionIntro.astro'
import Linebreak from '../components/UI/Linebreak.astro'
import SectionExperience from '../components/About/SectionExperience.astro'
import SectionStack from '../components/About/SectionStack.astro'
---
<Layout title="Lucas Ferrero | Fullstack Developer">
    <main>
        <div>
            <PageIntro title="About" subtitle="A few words about me" />
        </div>
        <div>
            <SectionIntro />
        </div>
        <Linebreak hasMargin={false} />
        <div>
            <SectionExperience />
        </div>
        <Linebreak hasMargin={false} />
        <div>
            <SectionStack />
        </div>
    </main>
</Layout>
